new file mode 100644
index 0000000..7663769
--- /dev/null
+++ b/backend/app/services/tiktok_media.py
@@ -0,0 +1,77 @@
+"""Destination-specific output. Never use the promotional render as a fallback."""
+import hashlib
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+
+
+def _hash(path):
+    with Path(path).open('rb') as source:
+        return hashlib.file_digest(source, 'sha256').hexdigest()
+
+
+def manifest_path(clip):
+    if not clip.clip_path:
+        raise ValueError('Clipe sem caminho de render.')
+    return Path(clip.clip_path).with_suffix('.tiktok.json')
+
+
+def _inputs(clip):
+    if not clip.video.file_path or not clip.subtitle_path:
+        raise ValueError('Video original e legendas salvas sao necessarios para preparar o TikTok.')
+    source = Path(clip.video.file_path)
+    captions = Path(clip.subtitle_path)
+    stat = source.stat()
+    if stat.st_size <= 0 or not captions.is_file() or clip.end_time <= clip.start_time or clip.start_time < 0:
+        raise ValueError('Fontes indisponiveis para gerar a versao TikTok.')
+    data = [1, str(source.resolve()), stat.st_size, stat.st_mtime_ns, _hash(captions),
+            clip.start_time, clip.end_time, clip.video.editing_style or 'default',
+            getattr(clip.video.project, 'subtitle_font_size', 12)]
+    return hashlib.sha256(json.dumps(data).encode()).hexdigest()
+
+
+def verified_tiktok_render(clip, signature):
+    """Reject missing, modified, stale or unreviewed media before remote upload."""
+    try:
+        data = json.loads(manifest_path(clip).read_text(encoding='utf-8'))
+        if not signature or signature != data['signature'] or data['inputs'] != _inputs(clip):
+            return None
+        path = manifest_path(clip).with_name(data['filename'])
+        if path.parent != manifest_path(clip).parent or path.name != f'{Path(clip.clip_path).stem}_tiktok_{signature}.mp4':
+            return None
+        return path if _hash(path) == data['sha256'] else None
+    except (OSError, ValueError, KeyError, TypeError):
+        return None
+
+
+def prepare_tiktok_render(clip):
+    """Caller holds the clip row lock. Render from original + saved captions."""
+    manifest = manifest_path(clip)
+    try:
+        signature = json.loads(manifest.read_text(encoding='utf-8'))['signature']
+        if verified_tiktok_render(clip, signature):
+            return signature
+    except (OSError, ValueError, KeyError, TypeError):
+        pass
+    inputs = _inputs(clip)
+    from app.services.video_cutter import generate_clip
+    from app.services.reel_adapter import adapt_to_reel
+    from app.services.subtitle_generator import burn_subtitles
+    manifest.parent.mkdir(parents=True, exist_ok=True)
+    with TemporaryDirectory(prefix='tiktok_', dir=manifest.parent) as tmp:
+        raw, reel, output = [str(Path(tmp) / name) for name in ('raw.mp4', 'reel.mp4', 'final.mp4')]
+        generate_clip(clip.video.file_path, raw, clip.start_time, clip.end_time)
+        adapt_to_reel(raw, reel, editing_style=clip.video.editing_style or 'default', show_logo=False)
+        burn_subtitles(reel, clip.subtitle_path, output,
+                       font_size=getattr(clip.video.project, 'subtitle_font_size', 12), source_video=raw)
+        if Path(output).stat().st_size <= 0 or _inputs(clip) != inputs:
+            raise ValueError('Fontes alteradas ou render TikTok vazio. Prepare novamente.')
+        digest = _hash(output)
+        signature = hashlib.sha256(f'{inputs}:{digest}'.encode()).hexdigest()
+        final = manifest.with_name(f'{Path(clip.clip_path).stem}_tiktok_{signature}.mp4')
+        Path(output).replace(final)
+        temporary_manifest = Path(tmp) / 'manifest.json'
+        temporary_manifest.write_text(json.dumps(dict(inputs=inputs, signature=signature,
+                                                      filename=final.name, sha256=digest)), encoding='utf-8')
+        temporary_manifest.replace(manifest)
+    return signature
