+"""Optional real FFmpeg smoke test: pip install imageio-ffmpeg; set FFMPEG_SMOKE=1.
+
+The probe helper reads FFmpeg metadata because the portable test package does
+not bundle ffprobe. Production continues to require ffmpeg AND ffprobe.
+"""
+import os
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace as NS
+from unittest.mock import patch
+
+
+@unittest.skipUnless(os.getenv('FFMPEG_SMOKE') == '1', 'Optional FFmpeg smoke test')
+class RealRenderTest(unittest.TestCase):
+    def test_clean_output_is_decodable_and_has_no_synthetic_promotional_overlay(self):
+        import imageio_ffmpeg
+        from app.services.tiktok_media import prepare_tiktok_render, verified_tiktok_render
+        executable = imageio_ffmpeg.get_ffmpeg_exe()
+        real_run = subprocess.run
+
+        def run(command, **kwargs):
+            return real_run([executable, *command[1:]], **kwargs)
+
+        def probe(path):
+            result = real_run([executable, '-hide_banner', '-i', str(path)], capture_output=True, text=True)
+            match = re.search(r'Video:.*?\b(\d{2,5})x(\d{2,5})\b', result.stderr)
+            if not match:
+                raise ValueError('Missing video dimensions')
+            return int(match[1]), int(match[2]), 0.5
+
+        with tempfile.TemporaryDirectory(dir='.tools', prefix='real_render_') as temporary:
+            root = Path(temporary)
+            source, primary, captions = root / 'source.mp4', root / 'primary.mp4', root / "clip user's [v1],.srt"
+            real_run([executable, '-y', '-f', 'lavfi', '-i', 'color=c=blue:s=640x360:r=10',
+                      '-t', '0.5', '-c:v', 'libx264', str(source)], check=True, capture_output=True)
+            real_run([executable, '-y', '-i', str(source), '-vf', 'drawbox=x=0:y=0:w=160:h=100:color=red:t=fill',
+                      '-c:v', 'libx264', str(primary)], check=True, capture_output=True)
+            captions.write_text('1\n00:00:00,000 --> 00:00:00,500\nTest caption\n', encoding='utf-8')
+            original_primary = primary.read_bytes()
+            clip = NS(clip_path=str(primary), subtitle_path=str(captions), start_time=0, end_time=0.5,
+                      video=NS(file_path=str(source), editing_style='default',
+                               project=NS(show_logo=True, subtitle_font_size=12)))
+            with patch('subprocess.run', side_effect=run), patch('app.services.reel_adapter.probe_media', side_effect=probe):
+                signature = prepare_tiktok_render(clip)
+            clean = verified_tiktok_render(clip, signature)
+            self.assertIsNotNone(clean)
+            self.assertEqual(probe(clean)[:2], (1080, 1920))
+            self.assertEqual(primary.read_bytes(), original_primary)
+            frame = real_run([executable, '-v', 'error', '-i', str(clean), '-frames:v', '1',
+                              '-vf', 'crop=100:100:0:0', '-f', 'rawvideo', '-pix_fmt', 'rgb24', '-'],
+                             check=True, capture_output=True).stdout
+            self.assertEqual(len(frame), 100 * 100 * 3)
+            self.assertFalse(any(frame[i] > 150 and frame[i + 1] < 80 and frame[i + 2] < 80
+                                 for i in range(0, len(frame), 3)))
