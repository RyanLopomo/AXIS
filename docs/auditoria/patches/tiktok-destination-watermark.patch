+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        for name, content in [('source.mp4', b'original'), ('clip.mp4', b'AXIS promo render'),
+                              ('clip.srt', b'1\n00:00:00,000 --> 00:00:01,000\nCaption\n')]:
+            (self.root / name).write_bytes(content)
+        self.clip = NS(id=1, clip_path=str(self.root / 'clip.mp4'),
+                       subtitle_path=str(self.root / 'clip.srt'), start_time=0, end_time=1,
+                       video=NS(file_path=str(self.root / 'source.mp4'), editing_style='default',
+                                project=NS(show_logo=True, watermark_enabled=True, subtitle_font_size=12)))
+        self.cut = self.enterContext(patch('app.services.video_cutter.generate_clip', side_effect=self.copy_output))
+        self.reel = self.enterContext(patch('app.services.reel_adapter.adapt_to_reel', side_effect=self.copy_output))
+        self.burn = self.enterContext(patch('app.services.subtitle_generator.burn_subtitles', side_effect=self.copy_output))
+
+    @staticmethod
+    def copy_output(source, *args, **kwargs):
+        output = args[1] if len(args) >= 2 and str(args[0]).endswith('.srt') else args[0]
+        Path(output).write_bytes(Path(source).read_bytes() + b' rendered')
+        return True
+
+    def prepare(self):
+        return media.prepare_tiktok_render(self.clip)
+
+    def publication(self, mode='inbox', signature=None):
+        return NS(platform_post_id=None, upload_started_at=None,
+                  publication_account=NS(scopes=json.dumps(['video.upload', 'video.publish'])),
+                  platform_options=json.dumps(dict(mode=mode, consent=True, reviewed=True,
+                                                   privacy_level='SELF_ONLY', media_signature=signature)))
+
+    def test_original_used_and_primary_untouched(self):
+        signature = self.prepare()
+        self.assertEqual(self.cut.call_args.args[0], self.clip.video.file_path)
+        self.assertIs(self.reel.call_args.kwargs['show_logo'], False)
+        self.assertEqual(Path(self.clip.clip_path).read_bytes(), b'AXIS promo render')
+        self.assertNotIn(b'AXIS promo', media.verified_tiktok_render(self.clip, signature).read_bytes())
+        self.assertTrue(self.clip.video.project.show_logo)
+
+    def test_cache_reuses_variant_without_rendering(self):
+        signature = self.prepare()
+        self.assertEqual(signature, self.prepare())
+        self.assertEqual(self.cut.call_count, 1)
+
+    def test_modified_output_is_rejected(self):
+        signature = self.prepare()
+        media.verified_tiktok_render(self.clip, signature).write_bytes(b'AXIS promotional')
+        self.assertIsNone(media.verified_tiktok_render(self.clip, signature))
+
+    def test_changed_captions_invalidate_review(self):
+        signature = self.prepare()
+        Path(self.clip.subtitle_path).write_text('new captions')
+        self.assertIsNone(media.verified_tiktok_render(self.clip, signature))
+        self.assertNotEqual(signature, self.prepare())
+
+    def test_missing_source_never_uses_promotional_render(self):
+        Path(self.clip.video.file_path).unlink()
+        with self.assertRaises(FileNotFoundError):
+            self.prepare()
+        self.assertIsNone(media.verified_tiktok_render(self.clip, 'unknown'))
+
+    def test_failed_render_does_not_create_manifest_or_fallback(self):
+        self.burn.side_effect = RuntimeError('ffmpeg failed')
+        with self.assertRaises(RuntimeError):
+            self.prepare()
+        self.assertFalse(media.manifest_path(self.clip).exists())
+        self.assertEqual(Path(self.clip.clip_path).read_bytes(), b'AXIS promo render')
+
+    def test_upload_uses_reviewed_variant_for_both_modes(self):
+        signature = self.prepare()
+        for mode in ('inbox', 'direct'):
+            with self.subTest(mode=mode), patch.dict(os.environ, TIKTOK_MEDIA_BASE_URL='https://verified.example'), \
+                    patch.object(tiktok, 'creator_info', return_value=dict(privacy_level_options=['SELF_ONLY'], max_video_post_duration_sec=60)), \
+                    patch.object(tiktok, 'call', return_value={'publish_id': 'remote-id'}) as call:
+                publication = self.publication(mode, signature)
+                db = Mock()
+                self.assertEqual(tiktok.upload(db, publication, self.clip), 'remote-id')
+                source = call.call_args.args[2]['source_info']
+                self.assertEqual(source['video_url'], f'https://verified.example/clips/1/tiktok/download?signature={signature}')
+                self.assertEqual(source['source'], 'PULL_FROM_URL')
+                self.assertEqual(tiktok.upload(db, publication, self.clip), 'remote-id')
+                self.assertEqual(call.call_count, 1)
+
+    def test_wrong_signature_cannot_start_upload(self):
+        self.prepare()
+        with patch.object(tiktok, 'call') as call:
+            with self.assertRaises(ValueError):
+                tiktok.upload(Mock(), self.publication(signature='wrong'), self.clip)
+            call.assert_not_called()
+
+    def test_inbox_requires_review_too(self):
+        publication = self.publication(signature=self.prepare())
+        options = json.loads(publication.platform_options)
+        options['reviewed'] = False
+        publication.platform_options = json.dumps(options)
+        with self.assertRaises(ValueError):
+            tiktok.upload(Mock(), publication, self.clip)
+
+    def test_ambiguous_intent_prevents_second_initialization(self):
+        publication = self.publication(signature=self.prepare())
+        publication.upload_started_at = 'already started'
+        with patch.object(tiktok, 'call') as call:
+            with self.assertRaises(tiktok.AmbiguousUploadError):
+                tiktok.upload(Mock(), publication, self.clip)
+            call.assert_not_called()
+
+    def test_media_endpoint_serves_same_file_and_rejects_stale_signature(self):
+        from app.api.clips import stream_tiktok_clip
+        from fastapi import HTTPException
+        signature = self.prepare()
+        db = Mock()
+        db.get.return_value = self.clip
+        self.assertEqual(Path(stream_tiktok_clip(1, signature, db).path), media.verified_tiktok_render(self.clip, signature))
+        with self.assertRaises(HTTPException) as error:
+            stream_tiktok_clip(1, 'wrong', db)
+        self.assertEqual(error.exception.status_code, 404)
+
+    def test_renderer_does_not_resolve_logo_when_disabled(self):
+        from app.services.reel_adapter import resolve_logo, build_filter
+        self.assertIsNone(resolve_logo(False, 'promotional.png'))
+        filters, has_logo = build_filter(1920, 1080, False)
+        self.assertFalse(has_logo)
+        self.assertNotIn('[1:v]', filters)
+
+    def test_consent_and_scope_guards_are_preserved(self):
+        publication = self.publication(signature=self.prepare())
+        options = json.loads(publication.platform_options)
+        options['consent'] = False
+        publication.platform_options = json.dumps(options)
+        with self.assertRaises(ValueError):
+            tiktok.upload(Mock(), publication, self.clip)
+        options['consent'] = True
+        publication.platform_options = json.dumps(options)
+        publication.publication_account.scopes = '[]'
+        with self.assertRaises(ValueError):
+            tiktok.upload(Mock(), publication, self.clip)
+
+    def test_cleanup_waits_for_both_destinations(self):
+        from sqlalchemy import create_engine
+        from sqlalchemy.orm import Session
+        from app.db.database import Base
+        from app.models import Project, Video, Clip, Publication
+        from app.youtube.cleanup import cleanup_clip_files
+        engine = create_engine('sqlite://')
+        self.addCleanup(engine.dispose)
+        Base.metadata.create_all(engine)
+        with Session(engine) as db:
+            project = Project(name='Two destinations', show_logo=True)
+            video = Video(project=project, source_type='FILE', file_path=self.clip.video.file_path)
+            clip = Clip(video=video, title='Clip', status='COMPLETED', start_time=0, end_time=1,
+                        clip_path=self.clip.clip_path, subtitle_path=self.clip.subtitle_path)
+            youtube = Publication(clip=clip, platform='YOUTUBE', status='PUBLISHED')
+            tiktok_job = Publication(clip=clip, platform='TIKTOK', status='REQUIRES_REVIEW')
+            db.add_all([youtube, tiktok_job])
+            db.commit()
+            signature = media.prepare_tiktok_render(clip)
+            clean = media.verified_tiktok_render(clip, signature)
+            self.assertFalse(cleanup_clip_files(clip, force=True))
+            self.assertTrue(clean.exists())
+            self.assertTrue(Path(clip.clip_path).exists())
+            tiktok_job.status = 'PUBLISHED'
+            db.commit()
+            self.assertTrue(cleanup_clip_files(clip, force=True))
+            self.assertFalse(clean.exists())
+            self.assertFalse(media.manifest_path(clip).exists())
+            self.assertTrue(Path(video.file_path).exists())
+            self.assertTrue(Path(clip.subtitle_path).exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
